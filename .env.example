# ─────────────────────────────────────────
# Suno → YouTube 업로더 환경 설정
# 이 파일을 .env로 복사 후 값을 채워주세요
# ─────────────────────────────────────────

# Anthropic API 키 (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-여기에_키를_입력하세요

# YouTube OAuth credentials JSON 파일 경로
# Google Cloud Console → API 및 서비스 → 사용자 인증 정보에서 생성
YOUTUBE_CREDENTIALS_FILE=credentials/client_secrets.json

# 기본 공개 설정: public / private / unlisted
# 처음에는 private으로 테스트 후 확인 뒤 public으로 변경 추천
DEFAULT_PRIVACY=private

# 업로드 로그 파일 경로
LOG_FILE=upload_log.jsonl
